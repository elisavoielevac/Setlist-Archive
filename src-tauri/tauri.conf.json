{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reaper Setlist Archive",
  "version": "0.1.0-beta.3",
  "identifier": "com.elisavoielevac.reapersetlisttracker",
  "build": {
    "frontendDist": [
      "../index.html",
      "../app.js",
      "../style.css",
      "../tracker-persistence.js"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Reaper Setlist Archive",
        "width": 1100,
        "height": 850,
        "minWidth": 700,
        "minHeight": 600,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../USER_MANUAL.md": "USER_MANUAL.md"
    }
  }
}
