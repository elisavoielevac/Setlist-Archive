{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reaper Setlist Tracker",
  "version": "0.1.0",
  "identifier": "com.elisavoielevac.reapersetlisttracker",
  "build": {
    "frontendDist": ["../index.html", "../app.js", "../style.css"]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Reaper Setlist Tracker",
        "width": 1100,
        "height": 850,
        "minWidth": 700,
        "minHeight": 600,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns"]
  }
}
